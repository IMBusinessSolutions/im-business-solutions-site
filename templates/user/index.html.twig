{% extends 'admin/_layout.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
    <div class="admin-content__head">
        <h1>Utilisateurs</h1>
        <a href="{{ path('app_user_new') }}" class="btn btn--gold">Nouvel utilisateur</a>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Nom</th>
                    <th>Rôle</th>
                    <th>Créé le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.email }}</td>
                    <td>{{ user.fullName }}</td>
                    <td>{{ user.role }}</td>
                    <td>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i') : '' }}</td>
                    <td class="admin-table__actions">
                        <a href="{{ path('app_user_show', {id: user.id}) }}">Voir</a>
                        <a href="{{ path('app_user_edit', {id: user.id}) }}">Modifier</a>
                        {{ include('user/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun utilisateur.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
