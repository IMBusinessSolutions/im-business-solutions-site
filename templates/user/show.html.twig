{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ user.fullName }}{% endblock %}

{% block body %}
    <div class="admin-content__head">
        <h1>{{ user.fullName }}</h1>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <tbody>
                <tr><th>ID</th><td>{{ user.id }}</td></tr>
                <tr><th>Email</th><td>{{ user.email }}</td></tr>
                <tr><th>Prénom</th><td>{{ user.firstName }}</td></tr>
                <tr><th>Nom</th><td>{{ user.lastName }}</td></tr>
                <tr><th>Rôle</th><td>{{ user.role }}</td></tr>
                <tr><th>Rôles de sécurité</th><td>{{ user.roles|join(', ') }}</td></tr>
                <tr><th>Créé le</th><td>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i') : '' }}</td></tr>
            </tbody>
        </table>
    </div>

    <p style="margin-top:20px;display:flex;gap:16px;align-items:center;">
        <a href="{{ path('app_user_edit', {id: user.id}) }}" class="btn btn--gold">Modifier</a>
        {{ include('user/_delete_form.html.twig') }}
    </p>
    <a href="{{ path('app_user_index') }}" class="admin-back">← Retour à la liste</a>
{% endblock %}
