{% extends 'admin/_layout.html.twig' %}

{% block title %}Connexion administrateur{% endblock %}

{% block body %}
    <div class="admin-login">
        <div class="admin-login__card">
            <p class="admin-login__eyebrow">Espace privé</p>
            <h1>Administration</h1>
            <p class="admin-login__intro">Connectez-vous pour gérer votre site web.</p>

            {% if error %}
                <div class="admin-login__error">L’adresse email ou le mot de passe est incorrect.</div>
            {% endif %}

            <form method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <label for="username">Adresse email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>

                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required>

                <button type="submit" class="btn btn--gold">Se connecter</button>
            </form>
        </div>
    </div>
{% endblock %}
